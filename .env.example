# Copy this file to .env and add your own keys.

GEMINI_API_KEY=your_gemini_api_key_here

# These can be changed without editing Python code.
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# local = Hugging Face Diffusers on your computer.
# placeholder = skip AI image generation and create simple placeholder panels.
IMAGE_PROVIDER=local

HF_TOKEN=your_huggingface_token_here
IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5

IMAGE_STEPS=20
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
